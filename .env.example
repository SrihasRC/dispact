# ─── Database ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres@localhost:5432/event_engine"

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""                 # leave empty for local dev

# ─── API Gateway ────────────────────────────────────────
API_PORT="4000"
API_HOST="0.0.0.0"
NODE_ENV="development"            # development | production

# ─── Idempotency ────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS="86400"   # 24h window for dedup lock

# ─── BullMQ Queues ──────────────────────────────────────
QUEUE_EVENT_INTAKE="event-intake"
QUEUE_DLQ="event-dlq"

# ─── Worker ─────────────────────────────────────────────
WORKER_CONCURRENCY="5"

# ─── Outbound: Resend ───────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"

# ─── Rate Limiter ───────────────────────────────────────
RATE_LIMIT_RESEND_TOKENS="10"       # token bucket capacity
RATE_LIMIT_RESEND_REFILL_MS="1000"  # refill interval ms

# ─── Bull Board (observability UI) ──────────────────────
BULL_BOARD_ENABLED="true"
BULL_BOARD_PATH="/admin/queues"
